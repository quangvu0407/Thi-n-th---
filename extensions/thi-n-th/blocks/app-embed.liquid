<aside
  class="thien-thu-banner thien-thu-banner--{{ block.settings.position }}"
  data-thien-thu-banner
  style="
    --thien-thu-banner-background: {{ block.settings.background_color }};
    --thien-thu-banner-color: {{ block.settings.text_color }};
    --thien-thu-banner-font-size: {{ block.settings.font_size }}px;
  "
  role="status"
>
  <span class="thien-thu-banner__message">
    {{ block.settings.message | escape }}
  </span>

  {% if block.settings.link != blank and block.settings.link_label != blank %}
    <a
      class="thien-thu-banner__link"
      href="{{ block.settings.link }}"
    >
      {{ block.settings.link_label | escape }}
    </a>
  {% endif %}

  {% if block.settings.dismissible %}
    <button
      class="thien-thu-banner__close"
      type="button"
      aria-label="Close banner"
      data-thien-thu-banner-close
    >
      &times;
    </button>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Thiên Thư banner",
  "target": "body",
  "stylesheet": "banner.css",
  "javascript": "banner.js",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Hello from Thiên Thư"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "bottom-right"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Show close button",
      "default": true
    }
  ]
}
{% endschema %}
